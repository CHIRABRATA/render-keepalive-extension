{
  "manifest_version": 3,
  "name": "Render Keep Alive",
  "version": "1.0",
  "description": "Keep Render backend awake",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}